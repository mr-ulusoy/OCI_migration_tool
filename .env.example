OCI_MIGRATOR_API_TOKEN=replace-with-a-long-random-token
OCI_MIGRATOR_ADMIN_USERNAME=admin
OCI_MIGRATOR_ADMIN_PASSWORD_HASH=pbkdf2_sha256$390000$replace-salt$replace-hash
OCI_MIGRATOR_SESSION_TTL_SECONDS=43200
OCI_MIGRATOR_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://YOUR_SERVER_IP:8000,http://localhost:5173,http://127.0.0.1:5173
OCI_MIGRATOR_REDIS_URL=redis://localhost:6379/0
OCI_MIGRATOR_LOG_LEVEL=INFO
OCI_MIGRATOR_RCLONE_TIMEOUT_SECONDS=7200
OCI_MIGRATOR_LOCAL_DATA_ROOT=/var/lib/oci-migrator/local
OCI_MIGRATOR_JOB_LOG_DIR=/var/log/oci-migrator/jobs
OCI_MIGRATOR_JOB_LOG_MAX_SIZE=10M
OCI_MIGRATOR_LOCAL_SHARE_HELPER=/usr/local/sbin/oci-migrator-local-share
OCI_MIGRATOR_LOCAL_SHARE_TIMEOUT_SECONDS=300
